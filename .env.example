# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"
USER_GEMINI_KEY=

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Neon Database
DATABASE_URL=
# The app will try these in order: RemoveBG -> PhotoRoom -> BriaAI -> Local AI
REMOVE_BG_API_KEY=
PHOTOROOM_API_KEY=
BRIA_API_KEY=
OPENROUTER_API_KEY=

# Additional Gemini API Keys for Rotation
VITE_GEMINI_KEY_1=
VITE_GEMINI_KEY_2=
VITE_GEMINI_KEY_3=
